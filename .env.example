# Set these in Render Dashboard > Web Service > Environment. Do not commit real secrets.
PORT=3000
APP_URL=https://YOUR-SERVICE.onrender.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Optional: set DATABASE_SSL=false only for a trusted local database connection.
DATABASE_SSL=true
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
